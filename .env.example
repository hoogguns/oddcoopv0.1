# OddCoop environment variables
# Copy to .env and fill in values before running locally or deploying.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3847
NODE_ENV=development

# ── JWT ────────────────────────────────────────────────────────────────────────
# REQUIRED in production — use a long random string (e.g. `openssl rand -hex 64`)
# The server will throw on startup if this is missing or set to the default in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=12h

# ── Database ───────────────────────────────────────────────────────────────────
# Defaults to data/oddcoop.json relative to project root.
# Override with an absolute path when using a persistent disk (e.g. Render Starter plan).
# DB_PATH=/var/data/oddcoop.json

# ── Rate limiting ──────────────────────────────────────────────────────────────
# All values are per-IP within the rolling window.
# RATE_LIMIT_WINDOW_MS=900000    # 15 minutes (default)
# RATE_LIMIT_AUTH_MAX=20         # login/register attempts per window (default)
# RATE_LIMIT_LEAD_MAX=10         # lead form submissions per window (default)
# RATE_LIMIT_PUBLIC_MAX=120      # general public API reads per window (default)

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave blank to allow all in dev).
# CORS_ORIGIN=https://wasatchbuybacks.oddcoop.com,https://oddcoop.com

# ── Tenant / subdomain ─────────────────────────────────────────────────────────
# In production each subdomain resolves automatically from the Host header.
# For local testing of a specific tenant override, set this:
# DEFAULT_TENANT_SLUG=wasatchbuybacks

# ── Email (optional — for lead notifications) ──────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM=noreply@oddcoop.com
# LEAD_NOTIFY_EMAIL=you@example.com

# ── Driver platform integrations (future) ─────────────────────────────────────
# ROADIE_API_KEY=
# SHIPT_API_KEY=
# UBER_DIRECT_CLIENT_ID=
# UBER_DIRECT_CLIENT_SECRET=
# DOORDASH_DEVELOPER_ID=
# DOORDASH_KEY_ID=
# DOORDASH_SIGNING_SECRET=
