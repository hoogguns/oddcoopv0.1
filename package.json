{
  "name": "oddcoop",
  "version": "0.1.0",
  "description": "OddCoop — cooperative same-day device buyback platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "lint": "eslint \"server.js\" \"server/**/*.js\" \"public/js/**/*.js\"",
    "lint:fix": "eslint --fix \"server.js\" \"server/**/*.js\" \"public/js/**/*.js\"",
    "format": "prettier --write \"server.js\" \"server/**/*.js\" \"public/js/**/*.js\" \"public/css/**/*.css\"",
    "format:check": "prettier --check \"server.js\" \"server/**/*.js\" \"public/js/**/*.js\" \"public/css/**/*.css\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
